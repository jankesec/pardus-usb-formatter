#: ui/MainWindow.glade:14
msgid "Format USB Devices easily."
msgstr "USB diskleri kolayca biçimlendirin."

#. Name Surname <example@examplemail.com>
#: ui/MainWindow.glade:18
msgid "translator-credits"
msgstr "Emin Fedar <emin.fedar@pardus.org.tr>"

#: ui/MainWindow.glade:53
msgid "Are you sure?"
msgstr "Emin misiniz?"

#: ui/MainWindow.glade:137
msgid "Will be formatted as:"
msgstr "Bu türde biçimlendirilecek:"

#: ui/MainWindow.glade:177
msgid ""
"<b>WARNING:</b>\n"
"All the personal data on the device will be deleted.\n"
"Do you want to continue?"
msgstr ""
"<b>UYARI:</b>\n"
"Cihazdaki tüm verileriniz silinecek.\n"
"Devam etmek istiyor musunuz?"

#: ui/MainWindow.glade:242 ui/MainWindow.glade:825 src/MainWindow.py:63
msgid "Pardus USB Formatter"
msgstr "Pardus USB Biçimlendirici"

#: ui/MainWindow.glade:280
msgid "<b><big>Pardus USB Formatter</big></b>"
msgstr "<b><big>Pardus USB Biçimlendirici</big></b>"

#: ui/MainWindow.glade:436
msgid "New Device Name"
msgstr "Yeni Cihaz İsmi"

#: ui/MainWindow.glade:453
msgid "Slow Format (Set all bytes to 0)"
msgstr "Yavaş Biçimlendir (Tüm baytları sıfırla)"

#: ui/MainWindow.glade:503
msgid "Encrypt Disk"
msgstr "Diski Şifrele"

#: ui/MainWindow.glade:546
msgid "Disk password"
msgstr "Disk Parolası"

#: ui/MainWindow.glade:576
msgid "Start"
msgstr "Başlat"

#: ui/MainWindow.glade:644 src/MainWindow.py:245
msgid "Formatting"
msgstr "Biçimlendiriliyor"

#: ui/MainWindow.glade:660
msgid "This may take a while."
msgstr "Bu biraz sürebilir."

#: ui/MainWindow.glade:673
msgid "Cancel"
msgstr "İptal Et"

#: ui/MainWindow.glade:746 src/MainWindow.py:249
msgid "Formatting is finished."
msgstr "Biçimlendirme tamamlandı."

#: ui/MainWindow.glade:772 src/MainWindow.py:249
msgid "You can eject the USB disk."
msgstr "USB diski çıkartabilirsiniz."

#: ui/MainWindow.glade:782
msgid "Quit"
msgstr "Çıkış"

#: ui/MainWindow.glade:800
msgid "Format another device."
msgstr "Başka bir cihaz biçimlendir."

#: src/MainWindow.py:67
msgid "About Pardus USB Formatter"
msgstr "Pardus USB Biçimlendirici Hakkında"

#: src/MainWindow.py:258
msgid "An error occured while formatting the disk."
msgstr "Disk biçimlendirilirken bir hata oluştu."

#: src/MainWindow.py:262
msgid ""
"Please make sure the USB device is connected properly, not used by any "
"program and try again."
msgstr ""
"Lütfen USB cihazın düzgün takılı olduğundan emin olun ve tekrar deneyin."

#: src/MainWindow.py:289
msgid "Password required."
msgstr "Parola gerekli."

#: src/MainWindow.py:290
msgid "Please provide a password for encrypt."
msgstr "Lütfen şifreleme için bir parola belirleyin."

#: src/MainWindow.py:298 src/MainWindow.py:318 src/MainWindow.py:326
#: src/MainWindow.py:337
msgid "Device name is too long."
msgstr "Cihaz ismi çok uzun."

#: src/MainWindow.py:300 src/MainWindow.py:319 src/MainWindow.py:328
#: src/MainWindow.py:338
msgid "{} format supports maximum {} characters."
msgstr "{} formatı en fazla {} karakteri destekliyor."

#: src/MainWindow.py:311
msgid "Device name contains invalid characters."
msgstr "Cihaz ismi geçersiz karakterler içeriyor."

#: src/MainWindow.py:312
msgid "FAT32 format only supports ASCII characters."
msgstr ""
"FAT32 formatı sadece ASCII karakterlerini desteklemektedir. Türkçe karakter "
"kullanmayınız."

#~ msgid "About"
#~ msgstr "Hakkında"

#~ msgid "Exit"
#~ msgstr "Çıkış Yap"
